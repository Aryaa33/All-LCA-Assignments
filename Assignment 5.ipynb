    "import re\n",
    "def check_string(s):\n",
    "    pattern=\"^[A-Za-z0-9]+$\" #^=start,$=end,+ = one or more\n",
    "    return bool(re.match(pattern, s))\n",
    "#example usage\n",
    "s1 = \"Hello123\"\n",
    "s2= \"Hello_123\" #contains underscore\n",
    "\n",
    "print(check_string(s1)) #true\n",
    "print(check_string(s2)) #false"
   ]
